{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earth-space-ai.org/scientific-resources/schema.json",
  "title": "Scientific Resource Tracker public dataset",
  "description": "Schema for the reviewed public opportunity snapshot used by both host profiles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "schema_version",
    "page_date",
    "page_timezone",
    "verified_at",
    "methodology",
    "counts",
    "opportunities"
  ],
  "properties": {
    "title": {
      "const": "Scientific Resource Tracker"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "page_date": {
      "type": "string",
      "format": "date"
    },
    "page_timezone": {
      "const": "America/Los_Angeles"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_policy",
        "endpoint_rule",
        "status_definitions"
      ],
      "properties": {
        "evidence_policy": {
          "type": "string",
          "minLength": 1
        },
        "endpoint_rule": {
          "type": "string",
          "minLength": 1
        },
        "status_definitions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "open",
            "upcoming",
            "closed",
            "stale-endpoint"
          ],
          "properties": {
            "open": {
              "type": "string",
              "minLength": 1
            },
            "upcoming": {
              "type": "string",
              "minLength": 1
            },
            "closed": {
              "type": "string",
              "minLength": 1
            },
            "stale-endpoint": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "open",
        "upcoming",
        "closed"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "open": {
          "type": "integer",
          "minimum": 0
        },
        "upcoming": {
          "type": "integer",
          "minimum": 0
        },
        "closed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "opportunities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/opportunity"
      }
    }
  },
  "$defs": {
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "program",
        "provider",
        "group",
        "group_label",
        "status",
        "amount",
        "deadline",
        "next_deadline",
        "deadline_kind",
        "closing_soon",
        "eligibility",
        "endpoint_note",
        "application_url",
        "apply_label",
        "official_source_urls",
        "verified_at",
        "verified_date"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "program": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "enum": [
            "credits",
            "hpc",
            "grants"
          ]
        },
        "group_label": {
          "enum": [
            "API & cloud research credits",
            "HPC & GPU allocations",
            "AI-for-science & open-science grants"
          ]
        },
        "status": {
          "enum": [
            "open",
            "upcoming",
            "closed"
          ]
        },
        "amount": {
          "type": "string",
          "minLength": 1
        },
        "deadline": {
          "type": "string",
          "minLength": 1
        },
        "next_deadline": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline_kind": {
          "enum": [
            "rolling",
            "fixed",
            "closed",
            "tbd"
          ]
        },
        "closing_soon": {
          "type": "boolean"
        },
        "eligibility": {
          "type": "string",
          "minLength": 1
        },
        "endpoint_note": {
          "type": "string",
          "minLength": 1
        },
        "application_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        },
        "apply_label": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "official_source_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "verified_date": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
