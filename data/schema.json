{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earth-space-ai.org/scientific-resources/schema.json",
  "title": "Scientific Resource Tracker public dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "schema_version",
    "page_date",
    "page_timezone",
    "verified_at",
    "methodology",
    "counts",
    "view_policy",
    "view_counts",
    "relevance_counts",
    "opportunities"
  ],
  "properties": {
    "title": {
      "const": "Scientific Resource Tracker"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "page_date": {
      "type": "string",
      "format": "date"
    },
    "page_timezone": {
      "const": "America/Los_Angeles"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_policy",
        "endpoint_rule",
        "status_definitions"
      ],
      "properties": {
        "evidence_policy": {
          "type": "string",
          "minLength": 1
        },
        "endpoint_rule": {
          "type": "string",
          "minLength": 1
        },
        "status_definitions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "open",
            "upcoming",
            "closed",
            "stale-endpoint"
          ],
          "properties": {
            "open": {
              "type": "string",
              "minLength": 1
            },
            "upcoming": {
              "type": "string",
              "minLength": 1
            },
            "closed": {
              "type": "string",
              "minLength": 1
            },
            "stale-endpoint": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "open",
        "upcoming",
        "closed"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "open": {
          "type": "integer",
          "minimum": 0
        },
        "upcoming": {
          "type": "integer",
          "minimum": 0
        },
        "closed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "view_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_view",
        "curated_classes",
        "all_scope_label"
      ],
      "properties": {
        "default_view": {
          "const": "curated"
        },
        "curated_classes": {
          "type": "array",
          "items": {
            "enum": [
              "direct",
              "adjacent"
            ]
          }
        },
        "all_scope_label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "view_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "curated",
        "all"
      ],
      "properties": {
        "curated": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "open",
            "upcoming",
            "closed"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "open": {
              "type": "integer",
              "minimum": 0
            },
            "upcoming": {
              "type": "integer",
              "minimum": 0
            },
            "closed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "all": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "open",
            "upcoming",
            "closed"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "open": {
              "type": "integer",
              "minimum": 0
            },
            "upcoming": {
              "type": "integer",
              "minimum": 0
            },
            "closed": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "relevance_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct",
        "adjacent",
        "unrelated"
      ],
      "properties": {
        "direct": {
          "type": "integer",
          "minimum": 0
        },
        "adjacent": {
          "type": "integer",
          "minimum": 0
        },
        "unrelated": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "opportunities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "program",
          "provider",
          "group",
          "group_label",
          "status",
          "amount",
          "deadline",
          "next_deadline",
          "deadline_kind",
          "closing_soon",
          "eligibility",
          "endpoint_note",
          "application_url",
          "apply_label",
          "official_source_urls",
          "verified_at",
          "verified_date",
          "first_seen",
          "last_verified",
          "retired_at",
          "retirement_reason",
          "superseded_by",
          "reactivated_at",
          "relevance",
          "landscape",
          "resources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "program": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "enum": [
              "credits",
              "hpc",
              "grants"
            ]
          },
          "group_label": {
            "enum": [
              "API & cloud research credits",
              "HPC & GPU allocations",
              "AI-for-science & open-science grants"
            ]
          },
          "status": {
            "enum": [
              "open",
              "upcoming",
              "closed"
            ]
          },
          "amount": {
            "type": "string",
            "minLength": 1
          },
          "deadline": {
            "type": "string",
            "minLength": 1
          },
          "next_deadline": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "deadline_kind": {
            "enum": [
              "rolling",
              "fixed",
              "closed",
              "tbd"
            ]
          },
          "closing_soon": {
            "type": "boolean"
          },
          "eligibility": {
            "type": "string",
            "minLength": 1
          },
          "endpoint_note": {
            "type": "string",
            "minLength": 1
          },
          "application_url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              {
                "type": "null"
              }
            ]
          },
          "apply_label": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "official_source_urls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          },
          "verified_date": {
            "type": "string",
            "format": "date"
          },
          "first_seen": {
            "type": "string",
            "format": "date"
          },
          "last_verified": {
            "type": "string",
            "format": "date"
          },
          "retired_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "retirement_reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "superseded_by": {
            "anyOf": [
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "reactivated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "relevance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "classification",
              "public_reason",
              "signals",
              "assessed_at",
              "assessed_by"
            ],
            "properties": {
              "classification": {
                "enum": [
                  "direct",
                  "adjacent",
                  "unrelated"
                ]
              },
              "public_reason": {
                "type": "string",
                "minLength": 1
              },
              "signals": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "assessed_at": {
                "type": "string",
                "format": "date-time"
              },
              "assessed_by": {
                "const": "researchassistant"
              }
            }
          },
          "landscape": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sponsor_sector",
              "sponsor_country",
              "applicant_geographies",
              "recipient_types",
              "science_domains"
            ],
            "properties": {
              "sponsor_sector": {
                "enum": [
                  "us_federal",
                  "us_state_local",
                  "foundation_nonprofit",
                  "industry",
                  "university_consortium",
                  "international_public",
                  "other"
                ]
              },
              "sponsor_country": {
                "type": "string",
                "pattern": "^[A-Z]{2}$|^MULTINATIONAL$|^UNKNOWN$"
              },
              "applicant_geographies": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "recipient_types": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "science_domains": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "quantification_status",
              "confidence",
              "reason",
              "effective_date",
              "source_refs",
              "relationship",
              "measures"
            ],
            "properties": {
              "quantification_status": {
                "enum": [
                  "quantified",
                  "partially_quantified",
                  "unquantified",
                  "individualized"
                ]
              },
              "confidence": {
                "enum": [
                  "official_explicit",
                  "official_partial",
                  "unresolved"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "effective_date": {
                "type": "string",
                "format": "date"
              },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "url",
                    "evidence_type",
                    "retrieved_at"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://"
                    },
                    "evidence_type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "retrieved_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              },
              "relationship": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "parent_id",
                  "rollup_policy"
                ],
                "properties": {
                  "parent_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "rollup_policy": {
                    "enum": [
                      "self",
                      "parent_only",
                      "child_only",
                      "exclude"
                    ]
                  }
                }
              },
              "measures": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "measure_id",
                    "resource_kind",
                    "accounting_bucket",
                    "basis",
                    "status_scope",
                    "amount",
                    "unit",
                    "period",
                    "source_refs",
                    "aggregation",
                    "warnings"
                  ],
                  "properties": {
                    "measure_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "resource_kind": {
                      "enum": [
                        "cash",
                        "cloud_credit",
                        "api_credit",
                        "compute_access",
                        "facility_access",
                        "fellowship",
                        "prize",
                        "other_in_kind"
                      ]
                    },
                    "accounting_bucket": {
                      "enum": [
                        "program_pool",
                        "per_award",
                        "cash",
                        "credit",
                        "compute",
                        "facility",
                        "prize",
                        "fellowship",
                        "other_in_kind"
                      ]
                    },
                    "basis": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status_scope": {
                      "enum": [
                        "current_only",
                        "archive_only",
                        "current_and_archive"
                      ]
                    },
                    "amount": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "minimum",
                        "maximum",
                        "exact",
                        "display"
                      ],
                      "properties": {
                        "minimum": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "maximum": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "exact": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "display": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "unit": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "code",
                        "native_label"
                      ],
                      "properties": {
                        "kind": {
                          "enum": [
                            "currency",
                            "credit_currency",
                            "allocation_credit",
                            "qpu_hour",
                            "node_hour",
                            "service_credit",
                            "count",
                            "unknown"
                          ]
                        },
                        "code": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "native_label": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "period": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "display"
                      ],
                      "properties": {
                        "kind": {
                          "enum": [
                            "one_time",
                            "annual",
                            "cycle",
                            "project_duration",
                            "unknown"
                          ]
                        },
                        "display": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "source_refs": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "url",
                          "evidence_type",
                          "retrieved_at"
                        ],
                        "properties": {
                          "url": {
                            "type": "string",
                            "format": "uri",
                            "pattern": "^https://"
                          },
                          "evidence_type": {
                            "type": "string",
                            "minLength": 1
                          },
                          "retrieved_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    },
                    "aggregation": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "include_in_rollup",
                        "rollup_group_key",
                        "double_count_key",
                        "dedupe_priority"
                      ],
                      "properties": {
                        "include_in_rollup": {
                          "type": "boolean"
                        },
                        "rollup_group_key": {
                          "type": "string",
                          "minLength": 1
                        },
                        "double_count_key": {
                          "type": "string",
                          "minLength": 1
                        },
                        "dedupe_priority": {
                          "type": "integer"
                        }
                      }
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
