{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earth-space-ai.org/scientific-resources/funding_pulse.schema.json",
  "title": "Scientific Resource Tracker Funding Pulse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "as_of_date",
    "scope",
    "record_totals",
    "view_record_counts",
    "snapshot_delta",
    "provenance",
    "coverage",
    "program_pools",
    "per_award_ranges",
    "credits",
    "compute_facility",
    "prizes_fellowships",
    "other_in_kind",
    "suppressed",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "snapshot_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-f0-9]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "object",
      "additionalProperties": true
    },
    "record_totals": {
      "type": "object",
      "additionalProperties": true
    },
    "view_record_counts": {
      "type": "object",
      "additionalProperties": true
    },
    "snapshot_delta": {
      "type": "object",
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_data_sha256",
        "change_manifest_sha256",
        "change_manifest_path",
        "change_manifest_url",
        "source_git"
      ],
      "properties": {
        "canonical_data_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "change_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "change_manifest_path": {
          "type": "string",
          "pattern": "^data/history/snapshots/[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-f0-9]{12}/change_manifest\\.json$"
        },
        "change_manifest_url": {
          "type": "string",
          "pattern": "^/scientific-resources/snapshots/[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-f0-9]{12}/change_manifest\\.json$"
        },
        "source_git": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_repository",
            "commit",
            "path"
          ],
          "properties": {
            "source_repository": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "path": {
              "const": "data/opportunities.json"
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": true
    },
    "program_pools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "per_award_ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "credits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "compute_facility": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "prizes_fellowships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "other_in_kind": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "suppressed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
