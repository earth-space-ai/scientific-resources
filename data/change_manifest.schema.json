{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earth-space-ai.org/scientific-resources/change_manifest.schema.json",
  "title": "Scientific Resource Tracker change manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "snapshot_id",
    "previous_snapshot_id",
    "comparison_basis",
    "current_data_sha256",
    "previous_data_sha256",
    "counts",
    "changes"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "snapshot_id": {
      "type": "string"
    },
    "previous_snapshot_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "comparison_basis": {
      "type": "string"
    },
    "current_data_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previous_data_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": true
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
