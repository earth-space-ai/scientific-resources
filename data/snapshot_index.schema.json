{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earth-space-ai.org/scientific-resources/snapshot_index.schema.json",
  "title": "Scientific Resource Tracker snapshot index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "current_snapshot_id",
    "generated_from",
    "snapshots"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "title": {
      "const": "Scientific Resource Tracker snapshot index"
    },
    "current_snapshot_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-f0-9]{12}$"
    },
    "generated_from": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_repository",
        "source_commit",
        "build_spec_version"
      ],
      "properties": {
        "source_repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "build_spec_version": {
          "enum": [
            "1.0.0",
            "1.1.0"
          ]
        }
      }
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "snapshot_id",
          "page_date",
          "page_timezone",
          "verified_at",
          "canonical_data_sha256",
          "record_count",
          "status_counts",
          "stable_id_sha256",
          "data_url",
          "change_manifest_url",
          "source"
        ],
        "properties": {}
      }
    }
  }
}
